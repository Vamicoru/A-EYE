<script>

const cameraPage = document.getElementById("camerapage");
const cameraVideo = document.getElementById("objcamera");

cameraPage.addEventListener("change", function() {

    if (cameraPage.checked) {

        navigator.mediaDevices.getUserMedia({
            video: {
                facingMode: "environment"
            },
            audio: false
        })

        .then(function(stream) {
            cameraVideo.srcObject = stream;
        })

        .catch(function(error) {
            console.log("Camera error:", error);
        });

    }

});


const readerPage = document.getElementById("readerpage");
const readerVideo = document.getElementById("readercamera");

readerPage.addEventListener("change", function() {

    if (readerPage.checked) {

        navigator.mediaDevices.getUserMedia({
            video: {
                facingMode: "environment"
            },
            audio: false
        })

        .then(function(stream) {
            readerVideo.srcObject = stream;
        })

        .catch(function(error) {
            console.log("Reader camera error:", error);
        });

    }

});

</script>
